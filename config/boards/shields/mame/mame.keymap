#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A &kp B  &kp C &kp D
                &kp X &mo 1  &mo 2 &kp Y
            >;
        };

        num_layer {
            bindings = <
                &kp N1 &kp N2  &kp N3 &kp N4
                &kp N5 &kp N6  &kp N7 &kp N8
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_CLR &bt BT_CLR_ALL
                &bt BT_SEL 2 &bt BT_SEL 3  &bt BT_NXT &kp N0
            >;
        };
    };
};