#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mo 1    &kp B   &kp C    &kp D
                &mo 1    &kp E   &mo 2    &mo 2
            >;
        };

        rgb_layer {
            bindings = <
                &rgb_ug RGB_ON    &rgb_ug RGB_OFF                    &rgb_ug RGB_ON    &rgb_ug RGB_OFF                   
                &rgb_ug RGB_EFF   &rgb_ug RGB_COLOR_HSB(128,100,100) &rgb_ug RGB_EFF   &rgb_ug RGB_COLOR_HSB(128,100,100)
            >;
        };
    };
 };

&led_strip {
    chain-length = <16>;
};