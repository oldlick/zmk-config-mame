#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A    &kp B
                &mo 1    &kp D
            >;
        };

        num_layer {
            bindings = <
                &rgb_ug RGB_ON    &rgb_ug RGB_OFF
                &rgb_ug RGB_EFF    &rgb_ug RGB_COLOR_HSB(128,100,100)
            >;
        };
    };
 };